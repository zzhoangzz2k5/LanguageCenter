@model IEnumerable<LanguageCenter.Models.Payment>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Manage Payments";
}

<h2>Manage Payments</h2>
<p><a href="/Admin/ExportPaymentsCsv" class="btn btn-success">Export CSV Report</a></p>

<table class="table table-bordered">
    <tr>
        <th>Payment</th>
        <th>Student</th>
        <th>Class</th>
        <th>Amount</th>
        <th>Payment Date</th>
        <th>Payment Status</th>
        <th>Action</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.PaymentId</td>
            <td>@(item.Registration != null && item.Registration.Student != null && item.Registration.Student.UserAccount != null ? item.Registration.Student.UserAccount.FullName : "Student")</td>
            <td>@(item.Registration != null && item.Registration.Class != null ? item.Registration.Class.ClassName : "Class")</td>
            <td>@String.Format("{0:N0}", item.Amount) VND</td>
            <td>@(item.PaymentDate.HasValue ? item.PaymentDate.Value.ToString("dd/MM/yyyy") : "Updating")</td>
            <td>@item.PaymentStatus</td>
            <td>
                @foreach (var status in new[] { "Confirmed", "Pending", "Failed" })
                {
                    using (Html.BeginForm("UpdatePaymentStatus", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.PaymentId" />
                        <input type="hidden" name="status" value="@status" />
                        <button class="btn btn-sm @(status == "Confirmed" ? "btn-success" : status == "Pending" ? "btn-warning" : "btn-danger")">@status</button>
                    }
                }
            </td>
        </tr>
    }
</table>
