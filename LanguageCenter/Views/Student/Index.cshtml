@model LanguageCenter.Models.StudentViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (Model == null)
{
    <h3>Student information not found</h3>
    return;
}

<h2>Student Profile</h2>

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <td>@Model.StudentId</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.FullName</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@(Model.IsActive ? "Active" : "Inactive")</td>
    </tr>

</table>