@{
    ViewBag.Title = "Register";
}

<h2>Register</h2>

@using (Html.BeginForm())
{
    <div class="form-group">
        <label>Full Name</label>
        <input name="fullname"
               class="form-control"
               required />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input type="email"
               name="email"
               class="form-control"
               required />
    </div>

    <div class="form-group">
        <label>Password</label>
        <input type="password"
               name="password"
               class="form-control"
               required />
    </div>

    <div class="form-group">
        <label>Confirm Password</label>
        <input type="password"
               name="confirmPassword"
               class="form-control"
               required />
    </div>

    <div class="form-group">
        <label>Register As</label>

        <select name="role" class="form-control">
            <option value="Student">Student</option>
            <option value="PendingTeacher">Teacher</option>
        </select>
    </div>

    <br />

    <button class="btn btn-success">
        Register
    </button>
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-info">
        @ViewBag.Message
    </div>
}