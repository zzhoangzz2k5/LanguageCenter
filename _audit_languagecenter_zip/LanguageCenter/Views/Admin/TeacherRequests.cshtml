@model List<LanguageCenter.Models.UserAccount>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Teacher Requests</h2>

<table class="table">
    <button class="btn btn-default"
            onclick="history.back();">
        ← Back
    </button>

    <tr>
        <th>Name</th>
        <th>Email</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.FullName</td>
            <td>@item.Email</td>

            <td>

                <a href="/Admin/ApproveTeacher/@item.UserId">
                    Approve
                </a>

            </td>

        </tr>
    }

</table>