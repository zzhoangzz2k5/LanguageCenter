@model IEnumerable<LanguageCenter.Models.TeacherViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Teacher Management";
}

<h2>Teacher Management</h2>

<p><a href="/Admin/CreateTeacher" class="btn btn-success">Add Teacher</a></p>

<table class="table table-bordered">
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Specialty</th>
        <th>Experience</th>
        <th>Status</th>
        <th>Action</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FullName</td>
            <td>@item.Email</td>
            <td>@item.Specialty</td>
            <td>@item.ExperienceYears years</td>
            <td>@(item.IsActive ? "Active" : "Inactive")</td>
            <td>
                <a href="/Admin/EditTeacher/@item.TeacherId" class="btn btn-warning btn-sm">Edit</a>
                @if (item.IsActive)
                {
                    using (Html.BeginForm("DeactivateTeacher", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.TeacherId" />
                        <button class="btn btn-danger btn-sm">Deactivate</button>
                    }
                }
                else
                {
                    using (Html.BeginForm("ActivateTeacher", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.TeacherId" />
                        <button class="btn btn-success btn-sm">Activate</button>
                    }
                }
            </td>
        </tr>
    }
</table>
