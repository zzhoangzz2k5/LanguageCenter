@model IEnumerable<LanguageCenter.Models.Program>

@{
    ViewBag.Title = "Home";
}

<div class="jumbotron text-center">
    <h1>LANGUAGE CENTER</h1>
    <p>Learn English - Japanese - Korean with professional teachers</p>

    <p>
        <a href="/Program" class="btn btn-primary btn-lg">
            Explore Programs
        </a>
    </p>
</div>

<hr />

<h2>Programs</h2>

<div class="row">

    @foreach (var p in Model)
    {
        <div class="col-md-4">

            <div class="panel panel-primary">

                <div class="panel-heading">
                    <h4>@p.ProgramName</h4>
                </div>

                <div class="panel-body">

                    <p>
                        <strong>Level:</strong>
                        @p.LevelName
                    </p>

                    <p>
                        <strong>Duration:</strong>
                        @p.DurationMonths months
                    </p>

                    <p>
                        <strong>Fee:</strong>
                        @String.Format("{0:N0}", p.Fee) VNĐ
                    </p>

                    <p>
                        @p.Description
                    </p>
                    <p>
                        <a href="/Program/Detail/@p.ProgramId"
                           class="btn btn-info">
                            View Detail
                        </a>
                    </p>

                </div>

            </div>

        </div>
    }

</div>

<hr />

<h2>New Classes</h2>

<table class="table table-bordered">

    <tr>
        <th>Class Name</th>
        <th>Start Date</th>
    </tr>

    @foreach (var c in ViewBag.Classes)
    {
        <tr>
            <td>@c.ClassName</td>
            <td>@c.StartDate</td>
        </tr>
    }

</table>

<hr />

<h2>Teachers</h2>

<div class="row">

    @foreach (var t in ViewBag.Teachers)
    {
        <div class="col-md-4">

            <div class="panel panel-default">

                <div class="panel-body text-center">

                    <h4>@t.GetType().GetProperty("FullName").GetValue(t, null)</h4>

                    <p>
                        Specialty:
                        @t.GetType().GetProperty("Specialty").GetValue(t, null)
                    </p>

                    <p>
                        Experience:
                        @t.GetType().GetProperty("ExperienceYears").GetValue(t, null)
                        years
                    </p>

                </div>

            </div>

        </div>
    }

</div>
