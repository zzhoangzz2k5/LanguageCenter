@model IEnumerable<LanguageCenter.Models.Program>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<h2>Program Management</h2>

<p>
    <a href="/Admin/CreateProgram"
       class="btn btn-success">
        Add Program
    </a>
</p>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Duration</th>
        <th>Fee</th>
        <th>Program Status</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.ProgramId</td>

            <td>@item.ProgramName</td>

            <td>@item.DurationMonths</td>

            <td>@String.Format("{0:N0}", item.Fee)</td>

            <td>

                <a href="/Admin/EditProgram/@item.ProgramId"
                   class="btn btn-warning btn-sm">
                    Edit
                </a>

                @if (item.ProgramStatus)
                {
                    <a href="/Admin/DeleteProgram/@item.ProgramId"
                       class="btn btn-danger btn-sm">
                        Deactivate
                    </a>
                }
                else
                {
                    <a href="/Admin/ActivateProgram/@item.ProgramId"
                       class="btn btn-success btn-sm">
                        Activate
                    </a>
                }

            </td>
            <td>
                @if (item.ProgramStatus)
                {
                    <span class="label label-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="label label-danger">
                        Inactive
                    </span>
                }
            </td>

        </tr>
    }

</table>