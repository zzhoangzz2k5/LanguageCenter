@model LanguageCenter.Models.UserAccount

@{
    ViewBag.Title = "Teacher Profile";
}

<h2>My Profile</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card profile-card">
    <div class="card-body text-center">
        <img src="@(Model == null || string.IsNullOrEmpty(Model.Photo) ? Url.Content("~/Content/images/teacher1.jpg") : Url.Content("~/Content/images/" + Model.Photo))" class="avatar-preview" alt="Teacher photo" />
        <h4 class="mt-3">@Model.FullName</h4>
        <p class="text-muted">@Model.Email</p>

        @using (Html.BeginForm("UploadPhoto", "Teacher", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <input type="file" name="photo" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" required />
            <button class="btn btn-primary mt-3">Upload Image</button>
        }
    </div>
</div>
