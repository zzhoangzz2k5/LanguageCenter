<!-- product two start -->
<div class="xc-product-two pb-80">
    <div class="container">
        <div class="xc-sec-heading">
            <h3 class="xc-sec-heading__title"><span><i class="icon-power"></i></span>Featured Phone</h3>
        </div>
        <div class="row gutter-y-20 row-cols-1 row-cols-md-2 row-cols-lg-4 row-cols-xl-5 ">
            @foreach (Product item in ViewBag.Featured)
            {
                <div class="col">
                    <div class="xc-product-two__item">
                        <span class="xc-product-two__deal d-none">BEST DEALS</span>
                        <div class="xc-product-two__img">
                            <img src="~/images/@item.Photo" alt="@item.Name">
                        </div>
                        <div class="xc-product-two__ratting">
                            <i class="icon-star"></i>
                            <i class="icon-star"></i>
                            <i class="icon-star"></i>
                            <i class="icon-star"></i>
                            <i class="icon-star"></i>
                            (125)
                        </div>
                        <h3 class="xc-product-two__title"><a href="/Product/@item.Slug">@item.Name</a></h3>
                        <h4 class="xc-product-two__price">@item.Price đ</h4>
                        <div class="xc-product-two__btn">
                            <a href="/Product/@item.Slug"><i class="icon-eye"></i></a>
                            <a href="cart.html"><i class="icon-grocery-store"></i></a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<!-- product two end -->

