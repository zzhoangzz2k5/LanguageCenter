@using LanguageCenter.Models

@{
    ViewBag.Title = "Home";

    var programs = ViewBag.Programs as List<Program>;
    var classes = ViewBag.Classes as List<Class>;
    var teachers = ViewBag.Teachers as List<UserAccount>;
}

<div class="hero-section">
    <div class="hero-overlay">
        <h1>Master English For Your Future</h1>
        <p>IELTS - TOEIC - TOEFL - Communication English. Build confidence with practical learning paths and experienced teachers.</p>
        <div>
            <a href="/Program" class="btn btn-warning btn-lg me-3">Explore Courses</a>
            @if (Session["UserId"] == null)
            {
                <a href="/Account/Register" class="btn btn-light btn-lg text-dark">Join Now</a>
            }
        </div>
    </div>
</div>

<section class="my-5">
    <div class="row g-4 text-center">
        <div class="col-md-3 col-sm-6">
            <div class="card stat-card">
                <div class="card-body">
                    <h2>@ViewBag.StudentCount+</h2>
                    <p>Active Students</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card stat-card">
                <div class="card-body">
                    <h2>@ViewBag.TeacherCount+</h2>
                    <p>Expert Instructors</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card stat-card">
                <div class="card-body">
                    <h2>@ViewBag.ClassCount+</h2>
                    <p>Active Classes</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card stat-card">
                <div class="card-body">
                    <h2>@ViewBag.ProgramCount+</h2>
                    <p>Modern Programs</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="my-5">
    <h2 class="section-title">Featured Programs</h2>
    <div class="row g-4 mt-2">
        @if (programs != null && programs.Count > 0)
        {
            foreach (var p in programs)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card course-card h-100 border-0">
                        <img src="@(string.IsNullOrEmpty(p.ProgramImage) ? Url.Content("~/Content/images/banner.jpg") : Url.Content("~/Content/images/" + p.ProgramImage))" class="program-image" alt="@p.ProgramName" />
                        <div class="card-body">
                            <h4>@p.ProgramName</h4>
                            <p><strong>Level:</strong> @p.LevelName</p>
                            <p><strong>Duration:</strong> @p.DurationMonths months</p>
                            <p><strong>Fee:</strong> <span class="text-primary font-weight-bold">@String.Format("{0:N0}", p.Fee) VND</span></p>
                            @if (!string.IsNullOrEmpty(p.Description))
                            {
                                <p class="text-muted mt-2 small">
                                    @(p.Description.Length > 90 ? p.Description.Substring(0, 87) + "..." : p.Description)
                                </p>
                            }
                        </div>
                        <div class="card-footer bg-white border-0 pt-0 pb-4 px-4">
                            <a href="/Program/Detail/@p.ProgramId" class="btn btn-outline-primary w-100">View Details</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted">
                <p>No programs available currently.</p>
            </div>
        }
    </div>
</section>

<section class="my-5">
    <h2 class="section-title">New Classes</h2>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Class</th>
                    <th>Room</th>
                    <th>Start Date</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (classes != null && classes.Count > 0)
                {
                    foreach (var item in classes)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.Room</td>
                            <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Updating")</td>
                            <td>@item.Status</td>
                            <td><a href="/Student/RegisterClass?classId=@item.ClassId" class="btn btn-primary btn-sm">Register</a></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">New class schedule is being updated.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="my-5">
    <h2 class="section-title">Meet Our Teachers</h2>
    <div class="row g-4 mt-2">
        @if (teachers != null && teachers.Count > 0)
        {
            foreach (var t in teachers)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card teacher-card h-100 border-0">
                        <img src="@(string.IsNullOrEmpty(t.Photo) ? Url.Content("~/Content/images/teacher1.jpg") : Url.Content("~/Content/images/" + t.Photo))" class="teacher-image" alt="@t.FullName" />
                        <div class="card-body text-center">
                            <h5>@t.FullName</h5>
                            <p class="text-muted small mb-3">Professional English Instructor</p>
                            <a href="/Teacher" class="btn btn-outline-primary btn-sm">View Profile</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted">
                <p>Teacher directory is currently updating.</p>
            </div>
        }
    </div>
</section>

<section class="cta-section">
    <h2>Start Learning Today</h2>
    <p>Join students improving their English skills. Master communication, secure certifications, and build a brighter career.</p>
    @if (Session["UserId"] == null)
    {
        <a href="/Account/Register" class="btn btn-warning btn-lg">Register Now</a>
    }
    else
    {
        <a href="/Program" class="btn btn-warning btn-lg">Explore More Courses</a>
    }
</section>
