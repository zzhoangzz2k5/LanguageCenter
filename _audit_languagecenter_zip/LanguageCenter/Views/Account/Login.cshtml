@{
    ViewBag.Title = "Login";
}

<div class="auth-panel">
    <h2>Login</h2>

    @using (Html.BeginForm())
    {
        <div class="mb-3">
            <label>Email</label>
            <input type="email" name="email" class="form-control" value="@(Request.Cookies["RememberEmail"] != null ? Request.Cookies["RememberEmail"].Value : "")" required />
        </div>

        <div class="mb-3">
            <label>Password</label>
            <input type="password" name="password" class="form-control" required />
        </div>

        <div class="form-check mb-3">
            <input type="checkbox" name="rememberMe" value="true" class="form-check-input" id="rememberMe" />
            <label class="form-check-label" for="rememberMe">Remember Me</label>
        </div>

        <button class="btn btn-primary">Login</button>
        <a href="/Account/ForgotPassword" class="btn btn-link">Forgot Password?</a>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3">@ViewBag.Error</div>
    }
</div>
