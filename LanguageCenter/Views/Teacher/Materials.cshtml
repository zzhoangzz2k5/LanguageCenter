@model IEnumerable<LanguageCenter.Models.MaterialViewModel>
@using LanguageCenter.Models

@{
    ViewBag.Title = "Manage Class Materials";
    var classes = ViewBag.Classes as List<Class>;
    int? selectedClassId = ViewBag.SelectedClassId as int?;
}

<h2>Manage Class Materials</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@using (Html.BeginForm("UploadMaterial", "Teacher", FormMethod.Post, new { enctype = "multipart/form-data", @class = "card p-4 mb-4" }))
{
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label>Class</label>
        <select name="classId" class="form-control" required>
            @foreach (var item in classes)
            {
                <option value="@item.ClassId" @(selectedClassId.HasValue && selectedClassId.Value == item.ClassId ? "selected" : "")>@item.ClassName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Upload Documents</label>
        <input type="file" name="document" class="form-control" accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.zip,.jpg,.jpeg,.png" required />
    </div>
    <button class="btn btn-success">Add Material</button>
}

<table class="table table-bordered">
    <tr>
        <th>Document</th>
        <th>Class</th>
        <th>Status / Edit</th>
        <th>Delete</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <a href="@Url.Content("~/Content/materials/" + item.FileName)" target="_blank">@item.DisplayName</a>
                <div class="small text-muted">@item.UploadedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </td>
            <td>@(classes.FirstOrDefault(x => x.ClassId == item.ClassId)?.ClassName ?? ("Class " + item.ClassId))</td>
            <td>
                @using (Html.BeginForm("EditMaterial", "Teacher", FormMethod.Post, new { @class = "d-flex gap-2 align-items-center flex-wrap" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fileName" value="@item.FileName" />
                    <input type="hidden" name="classId" value="@selectedClassId" />
                    <input type="text" name="displayName" value="@item.DisplayName" class="form-control form-control-sm" style="max-width:240px" required />
                    <select name="isActive" class="form-select form-select-sm" style="max-width:130px">
                        <option value="true" @(item.IsActive ? "selected" : "")>Published</option>
                        <option value="false" @(!item.IsActive ? "selected" : "")>Hidden</option>
                    </select>
                    <button class="btn btn-warning btn-sm">Save</button>
                }
            </td>
            <td>
                @using (Html.BeginForm("DeleteMaterial", "Teacher", FormMethod.Post, new { onsubmit = "return confirm('Delete this material?');" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fileName" value="@item.FileName" />
                    <input type="hidden" name="classId" value="@selectedClassId" />
                    <button class="btn btn-danger btn-sm">Delete</button>
                }
            </td>
        </tr>
    }
</table>
