@model IEnumerable<LanguageCenter.Models.UserAccount>

<h2 class="mb-4">Our Teachers</h2>

<div class="row">

    @foreach (var t in Model)
    {
        <div class="col-md-4">

            <div class="card teacher-card">

                <img src="~/Content/images/teacher1.jpg"
                     class="card-img-top" />

                <div class="card-body">

                    <h5>@t.FullName</h5>

                    <p>@t.Email</p>

                </div>

            </div>

        </div>
    }

</div>