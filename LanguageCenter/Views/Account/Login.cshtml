@{
    ViewBag.Title = "Login";
}

<h2>Login</h2>

@using (Html.BeginForm())
{
    <div class="mb-3">
        <label>Email</label>
        <input type="email"
               name="email"
               class="form-control"
               required />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <input type="password"
               name="password"
               class="form-control"
               required />
    </div>

    <button class="btn btn-primary">
        Login
    </button>
}

@if (ViewBag.Error != null)
{
    <div class="text-danger mt-3">
        @ViewBag.Error
    </div>
}