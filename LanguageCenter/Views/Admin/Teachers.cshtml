@model IEnumerable<LanguageCenter.Models.TeacherViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Teacher Management</h2>

<table class="table table-bordered">

    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Specialty</th>
        <th>Experience</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.FullName</td>
            <td>@item.Email</td>
            <td>@item.Specialty</td>
            <td>@item.ExperienceYears years</td>

            <td>
                @(item.IsActive ? "Active" : "Inactive")
            </td>

            <td>

                @if (item.IsActive)
                {
                    <a href="/Admin/DeactivateTeacher/@item.TeacherId"
                       class="btn btn-danger btn-sm">
                        Deactivate
                    </a>
                }
                else
                {
                    <a href="/Admin/ActivateTeacher/@item.TeacherId"
                       class="btn btn-success btn-sm">
                        Activate
                    </a>
                }

            </td>

        </tr>
    }

</table>