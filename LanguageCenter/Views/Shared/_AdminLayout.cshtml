<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        body {
            margin: 0;
            background: #f4f6f9;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            position: fixed;
            width: 250px;
            height: 100%;
            background: #1f2937;
            left: 0;
            top: 0;
            overflow-y: auto;
        }

        .sidebar h3 {
            color: white;
            text-align: center;
            padding: 20px 0;
            border-bottom: 1px solid #374151;
        }

        .sidebar a {
            display: block;
            color: #d1d5db;
            padding: 14px 20px;
            text-decoration: none;
            transition: 0.2s;
        }

        .sidebar a:hover {
            background: #374151;
            color: white;
        }

        .main {
            margin-left: 250px;
        }

        .topbar {
            background: white;
            padding: 15px 25px;
            box-shadow: 0 2px 10px rgba(0,0,0,.1);
        }

        .content {
            padding: 25px;
        }

        .user-info {
            float: right;
            font-weight: bold;
        }

        .logout {
            color: #f87171 !important;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h3>LANGUAGE CENTER</h3>
        <a href="/Admin">Dashboard</a>
        <a href="/Admin/RegistrationRequests">Account Requests</a>
        <a href="/Admin/Students">Students</a>
        <a href="/Admin/Teachers">Teachers</a>
        <a href="/Admin/Programs">Programs</a>
        <a href="/Admin/ProgramTypes">Program Types</a>
        <a href="/Admin/Classes">Classes</a>
        <a href="/Admin/Registrations">Registrations</a>
        <a href="/Admin/Payments">Payments</a>
        <a href="/Admin/PlacementTests">Placement Tests</a>
        <a href="/Home">Public Website</a>
        <a href="/Account/Logout" class="logout">Logout</a>
    </div>

    <div class="main">
        <div class="topbar">
            <span>Welcome, <strong>@Session["FullName"]</strong></span>
            <span class="user-info">Admin Panel</span>
        </div>

        <div class="content">
            @RenderBody()
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
</body>
</html>
