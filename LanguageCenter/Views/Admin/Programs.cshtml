@model IEnumerable<LanguageCenter.Models.Program>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Program Management";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h2>Program Management</h2>

<p>
    <a href="/Admin/CreateProgram" class="btn btn-success">Add Program</a>
    <a href="/Admin/ProgramTypes" class="btn btn-outline-primary">Manage Program Types</a>
</p>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Duration</th>
        <th>Fee</th>
        <th>Program Status</th>
        <th>Action</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ProgramId</td>
            <td>@item.ProgramName</td>
            <td>@item.DurationMonths months</td>
            <td>@String.Format("{0:N0}", item.Fee) VND</td>
            <td>@(item.ProgramStatus ? "Active" : "Inactive")</td>
            <td>
                <a href="/Admin/EditProgram/@item.ProgramId" class="btn btn-warning btn-sm">Edit</a>
                @if (item.ProgramStatus)
                {
                    using (Html.BeginForm("DeleteProgram", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.ProgramId" />
                        <button class="btn btn-danger btn-sm">Deactivate</button>
                    }
                }
                else
                {
                    using (Html.BeginForm("ActivateProgram", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.ProgramId" />
                        <button class="btn btn-success btn-sm">Activate</button>
                    }
                }
            </td>
        </tr>
    }
</table>
