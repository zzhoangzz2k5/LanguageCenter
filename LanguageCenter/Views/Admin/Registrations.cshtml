@model IEnumerable<LanguageCenter.Models.Registration>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Manage Registrations";
}

<h2>Manage Registrations</h2>

<table class="table table-bordered">
    <tr>
        <th>Student</th>
        <th>Class</th>
        <th>Registration Date</th>
        <th>Status</th>
        <th>Action</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@(item.Student != null && item.Student.UserAccount != null ? item.Student.UserAccount.FullName : "Student")</td>
            <td>@(item.Class != null ? item.Class.ClassName : "Class")</td>
            <td>@(item.RegistrationDate.HasValue ? item.RegistrationDate.Value.ToString("dd/MM/yyyy") : "Updating")</td>
            <td>@item.Status</td>
            <td>
                <a href="/Admin/UpdateRegistrationStatus/@item.RegistrationId?status=Confirmed" class="btn btn-success btn-sm">Confirm</a>
                <a href="/Admin/UpdateRegistrationStatus/@item.RegistrationId?status=Cancelled" class="btn btn-danger btn-sm">Cancel Registration</a>
            </td>
        </tr>
    }
</table>
