@model IEnumerable<LanguageCenter.Models.Program>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Programs";
    var levels = ViewBag.Levels as List<string>;
    int page = ViewBag.Page == null ? 1 : (int)ViewBag.Page;
    int totalPages = ViewBag.TotalPages == null ? 0 : (int)ViewBag.TotalPages;
}

<div class="page-heading">
    <h2>Programs</h2>
    <p class="text-muted">Find the right English program by level, duration, and fee.</p>
</div>

@using (Html.BeginForm("Index", "Program", FormMethod.Get, new { @class = "filter-bar" }))
{
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by program name" />
    <select name="level" class="form-control">
        <option value="">All levels</option>
        @if (levels != null)
        {
            foreach (var item in levels)
            {
                <option value="@item" @(ViewBag.Level == item ? "selected" : "")>@item</option>
            }
        }
    </select>
    <button class="btn btn-primary">Search</button>
}

@if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
{
    <p class="mt-3">
        <a href="/Program/Create" class="btn btn-success">Add Program</a>
    </p>
}

<div class="row g-4 mt-2">
    @foreach (var item in Model)
    {
        <div class="col-lg-4 col-md-6">
            <div class="card course-card h-100">
                <img src="@(string.IsNullOrEmpty(item.ProgramImage) ? Url.Content("~/Content/images/banner.jpg") : Url.Content("~/Content/images/" + item.ProgramImage))" class="program-image" alt="@item.ProgramName" />
                <div class="card-body">
                    <h4>@item.ProgramName</h4>
                    <p><b>Level:</b> @item.LevelName</p>
                    <p><b>Duration:</b> @item.DurationMonths months</p>
                    <p><b>Fee:</b> @String.Format("{0:N0}", item.Fee) VND</p>
                    <a href="/Program/Detail/@item.ProgramId" class="btn btn-primary">Detail</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-4">No programs matched your search.</div>
}

@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" href="/Program?search=@ViewBag.Search&level=@ViewBag.Level&page=@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<a href="/Home" class="btn btn-secondary mt-3">Home</a>
