@model LanguageCenter.Models.StudentViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Edit Student";
}

<h2>Edit Student Information</h2>

@using (Html.BeginForm("EditStudent", "Admin", FormMethod.Post, new { @class = "card p-4" }))
{
    <input type="hidden" name="studentId" value="@Model.StudentId" />
    <div class="mb-3">
        <label>Full Name</label>
        <input name="fullName" value="@Model.FullName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Email</label>
        <input type="email" name="email" value="@Model.Email" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Phone</label>
        <input name="phone" value="@Model.Phone" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Address</label>
        <input name="address" value="@Model.Address" class="form-control" />
    </div>
    <button class="btn btn-success">Save</button>
}
