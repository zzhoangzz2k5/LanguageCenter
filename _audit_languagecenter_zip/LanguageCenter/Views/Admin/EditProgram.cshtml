@model LanguageCenter.Models.Program

@{
    ViewBag.Title = "EditProgram";
}

<h2>Edit Program</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(x => x.ProgramId)

    <div class="form-group">
        <label>Program Name</label>
        @Html.TextBoxFor(x => x.ProgramName,
            new { @class = "form-control" })
    </div>

    <br />

    <div class="form-group">
        <label>Level</label>
        @Html.TextBoxFor(x => x.LevelName,
            new { @class = "form-control" })
    </div>

    <br />

    <div class="form-group">
        <label>Duration</label>
        @Html.TextBoxFor(x => x.DurationMonths,
            new { @class = "form-control" })
    </div>

    <br />

    <div class="form-group">
        <label>Fee</label>
        @Html.TextBoxFor(x => x.Fee,
            new { @class = "form-control" })
    </div>

    <br />

    <div class="form-group">
        <label>Description</label>
        @Html.TextAreaFor(x => x.Description,
            new { @class = "form-control", rows = 5 })
    </div>

    <br />

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a href="/Admin/Programs"
       class="btn btn-default">
        Back
    </a>
}