@model IEnumerable<LanguageCenter.Models.Class>

@{
    ViewBag.Title = "My Teaching Classes";
}

<h2>My Teaching Classes</h2>

<table class="table table-bordered">
    <tr>
        <th>Class List</th>
        <th>Schedule</th>
        <th>Room</th>
        <th>Student Count</th>
        <th>Class Status</th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ClassName</td>
            <td>@((item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Updating") + " - " + (item.EndDate.HasValue ? item.EndDate.Value.ToString("dd/MM/yyyy") : "Updating"))</td>
            <td>@item.Room</td>
            <td>@item.Registrations.Count</td>
            <td>@item.Status</td>
            <td>
                <a href="/Teacher/ClassStudents/@item.ClassId" class="btn btn-primary btn-sm">Students</a>
                <a href="/Teacher/Materials?classId=@item.ClassId" class="btn btn-outline-primary btn-sm">Materials</a>
            </td>
        </tr>
    }
</table>
