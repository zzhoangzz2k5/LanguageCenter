@model IEnumerable<LanguageCenter.Models.StudentViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Student Management";
}

<h2>Student Management</h2>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Full Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Status</th>
        <th>Action</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.StudentId</td>
            <td>@item.FullName</td>
            <td>@item.Email</td>
            <td>@item.Phone</td>
            <td>@(item.IsActive ? "Active" : "Inactive")</td>
            <td>
                <a href="/Admin/EditStudent/@item.StudentId" class="btn btn-warning btn-sm">Edit</a>
                @if (item.IsActive)
                {
                    <a href="/Admin/DeactivateStudent/@item.StudentId" class="btn btn-danger btn-sm">Deactivate</a>
                }
                else
                {
                    <a href="/Admin/ActivateStudent/@item.StudentId" class="btn btn-success btn-sm">Activate</a>
                }
            </td>
        </tr>
    }
</table>
