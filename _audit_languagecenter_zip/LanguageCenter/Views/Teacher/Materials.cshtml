@model IEnumerable<string>
@using LanguageCenter.Models

@{
    ViewBag.Title = "Manage Class Materials";
    var classes = ViewBag.Classes as List<Class>;
    int? selectedClassId = ViewBag.SelectedClassId as int?;
}

<h2>Manage Class Materials</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@using (Html.BeginForm("UploadMaterial", "Teacher", FormMethod.Post, new { enctype = "multipart/form-data", @class = "card p-4 mb-4" }))
{
    <div class="mb-3">
        <label>Class</label>
        <select name="classId" class="form-control" required>
            @foreach (var item in classes)
            {
                <option value="@item.ClassId" @(selectedClassId.HasValue && selectedClassId.Value == item.ClassId ? "selected" : "")>@item.ClassName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Upload Documents</label>
        <input type="file" name="document" class="form-control" required />
    </div>
    <button class="btn btn-success">Add Material</button>
}

<table class="table table-bordered">
    <tr>
        <th>Document</th>
        <th>Edit Material</th>
        <th>Delete Material</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td><a href="/Content/materials/@item" target="_blank">@item</a></td>
            <td><span class="text-muted">Upload again to replace with a newer document.</span></td>
            <td><a href="/Teacher/DeleteMaterial?fileName=@item&classId=@selectedClassId" class="btn btn-danger btn-sm">Delete</a></td>
        </tr>
    }
</table>
