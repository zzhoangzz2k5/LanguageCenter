@model List<LanguageCenter.Models.UserAccount>

<h2>Teacher Requests</h2>

<table class="table">

    <tr>
        <th>Name</th>
        <th>Email</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.FullName</td>
            <td>@item.Email</td>

            <td>

                <a href="/Admin/ApproveTeacher/@item.UserId">
                    Approve
                </a>

            </td>

        </tr>
    }

</table>