@model LanguageCenter.Models.Program

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Add Program</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <p>
        Program Name
        <input type="text"
               name="ProgramName"
               class="form-control" />
    </p>

    <p>
        Level
        <input type="text"
               name="LevelName"
               class="form-control" />
    </p>

    <p>
        Duration
        <input type="number"
               name="DurationMonths"
               class="form-control" />
    </p>

    <p>
        Fee
        <input type="number"
               name="Fee"
               class="form-control" />
    </p>

    <p>
        Description
        <textarea name="Description"
                  class="form-control"></textarea>
    </p>

    <button class="btn btn-success">
        Save
    </button>
}

<br />

<a href="/Program"
   class="btn btn-secondary">
    Back
</a>
