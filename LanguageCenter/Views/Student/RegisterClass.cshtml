@model IEnumerable<LanguageCenter.Models.Class>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Register Class";
    int? selectedClassId = ViewBag.SelectedClassId as int?;
}

<div class="page-heading">
    <h2>Register Class</h2>
    <p class="text-muted">Select a class, review registration information, and submit for confirmation.</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@using (Html.BeginForm("RegisterClass", "Student", FormMethod.Post, new { @class = "card p-4 mb-4" }))
{
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label>Class Selection</label>
        <select name="classId" class="form-control" required>
            @foreach (var item in Model)
            {
                <option value="@item.ClassId" @(selectedClassId.HasValue && selectedClassId.Value == item.ClassId ? "selected" : "")>
                    @item.ClassName - @item.Room - @(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Updating")
                </option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Registration Information</label>
        <textarea name="note" class="form-control" rows="3" placeholder="Note for the center"></textarea>
    </div>
    <button class="btn btn-success">Confirm Registration</button>
}

<div class="table-responsive">
    <table class="table table-striped">
        <tr>
            <th>Class</th>
            <th>Room</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ClassName</td>
                <td>@item.Room</td>
                <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Updating")</td>
                <td>@(item.EndDate.HasValue ? item.EndDate.Value.ToString("dd/MM/yyyy") : "Updating")</td>
                <td>@item.Status</td>
            </tr>
        }
    </table>
</div>
