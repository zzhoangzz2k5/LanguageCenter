@model LanguageCenter.Models.Class
@using LanguageCenter.Models

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Edit Class";
    var programs = ViewBag.Programs as List<Program>;
    var teachers = ViewBag.Teachers as List<Teacher>;
}

<h2>Edit Class</h2>

@using (Html.BeginForm("EditClass", "Admin", FormMethod.Post, new { @class = "card p-4" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="ClassId" value="@Model.ClassId" />
    <div class="mb-3"><label>Class Name</label><input name="ClassName" value="@Model.ClassName" class="form-control" required /></div>
    <div class="mb-3">
        <label>Program</label>
        <select name="ProgramId" class="form-control" required>
            @foreach (var item in programs)
            {
                <option value="@item.ProgramId" @(Model.ProgramId == item.ProgramId ? "selected" : "")>@item.ProgramName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Assign Teacher</label>
        <select name="TeacherId" class="form-control" required>
            @foreach (var item in teachers)
            {
                <option value="@item.TeacherId" @(Model.TeacherId == item.TeacherId ? "selected" : "")>@item.UserAccount.FullName</option>
            }
        </select>
    </div>
    <div class="mb-3"><label>Room</label><input name="Room" value="@Model.Room" class="form-control" /></div>
    <div class="mb-3"><label>Start Date</label><input type="date" name="StartDate" value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : "")" class="form-control" /></div>
    <div class="mb-3"><label>End Date</label><input type="date" name="EndDate" value="@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "")" class="form-control" /></div>
    <div class="mb-3"><label>Capacity</label><input type="number" name="Capacity" value="@Model.Capacity" class="form-control" min="1" /></div>
    <div class="mb-3"><label>Status</label><input name="Status" value="@Model.Status" class="form-control" /></div>
    <button class="btn btn-success">Save</button>
}
