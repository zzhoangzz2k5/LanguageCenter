@model IEnumerable<LanguageCenter.Models.Registration>

@{
    ViewBag.Title = "Class Students";
}

<h2>View Class Students - @ViewBag.ClassName</h2>

<table class="table table-bordered">
    <tr>
        <th>Student List</th>
        <th>Registration Date</th>
        <th>Payment Status</th>
        <th>Attendance Status</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@(item.Student != null && item.Student.UserAccount != null ? item.Student.UserAccount.FullName : "Student")</td>
            <td>@(item.RegistrationDate.HasValue ? item.RegistrationDate.Value.ToString("dd/MM/yyyy") : "Updating")</td>
            <td>@(item.Payments.Any() ? item.Payments.First().PaymentStatus : "Unpaid")</td>
            <td>@item.Status</td>
        </tr>
    }
</table>
