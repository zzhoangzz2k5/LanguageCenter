@model IEnumerable<LanguageCenter.Models.Class>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Class Management";
}

<h2>Class Management</h2>

<p><a href="/Admin/CreateClass" class="btn btn-success">Add Class</a></p>

<table class="table table-bordered">
    <tr>
        <th>Class</th>
        <th>Program</th>
        <th>Teacher</th>
        <th>Room</th>
        <th>Schedule</th>
        <th>Capacity</th>
        <th>Class Status</th>
        <th>Action</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ClassName</td>
            <td>@(item.Program != null ? item.Program.ProgramName : "Updating")</td>
            <td>@(item.Teacher != null && item.Teacher.UserAccount != null ? item.Teacher.UserAccount.FullName : "Updating")</td>
            <td>@item.Room</td>
            <td>@((item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Updating") + " - " + (item.EndDate.HasValue ? item.EndDate.Value.ToString("dd/MM/yyyy") : "Updating"))</td>
            <td>@item.Capacity</td>
            <td>@item.Status</td>
            <td>
                <a href="/Admin/EditClass/@item.ClassId" class="btn btn-warning btn-sm">Edit</a>
                @using (Html.BeginForm("DeleteClass", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@item.ClassId" />
                    <button class="btn btn-danger btn-sm">Deactivate</button>
                }
            </td>
        </tr>
    }
</table>
