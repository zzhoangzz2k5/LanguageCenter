@model IEnumerable<LanguageCenter.Models.Registration>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Classes";
}

<h2>My Classes</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive">
    <table class="table table-bordered">
        <tr>
            <th>Registered Class</th>
            <th>Schedule</th>
            <th>Teacher</th>
            <th>Registration Date</th>
            <th>Registration Status</th>
            <th>Detail</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.Class != null ? item.Class.ClassName : "Updating")</td>
                <td>
                    @if (item.Class != null)
                    {
                        @((item.Class.StartDate.HasValue ? item.Class.StartDate.Value.ToString("dd/MM/yyyy") : "Updating") + " - " + (item.Class.EndDate.HasValue ? item.Class.EndDate.Value.ToString("dd/MM/yyyy") : "Updating"))
                    }
                </td>
                <td>@(item.Class != null && item.Class.Teacher != null && item.Class.Teacher.UserAccount != null ? item.Class.Teacher.UserAccount.FullName : "Updating")</td>
                <td>@(item.RegistrationDate.HasValue ? item.RegistrationDate.Value.ToString("dd/MM/yyyy") : "Updating")</td>
                <td>@item.Status</td>
                <td><a href="/Student/RegistrationConfirmation/@item.RegistrationId" class="btn btn-outline-primary btn-sm">View</a></td>
            </tr>
        }
    </table>
</div>
