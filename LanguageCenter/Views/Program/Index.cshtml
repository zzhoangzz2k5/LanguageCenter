@model IEnumerable<LanguageCenter.Models.Program>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Programs</h2>

<p>
    @if (Session["Role"] != null &&
         Session["Role"].ToString() == "Admin")
    {
        <a href="/Program/Create"
           class="btn btn-success">
            Add Program
        </a>
    }
</p>

<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-md-4">

            <div class="card mb-4 shadow">

                <div class="card-body">

                    <h4>@item.ProgramName</h4>

                    <p><b>Level:</b> @item.LevelName</p>

                    <p>
                        <b>Duration:</b>
                        @item.DurationMonths months
                    </p>

                    <p>
                        <b>Fee:</b>
                        @String.Format("{0:N0}", item.Fee) VNĐ
                    </p>

                    <a href="/Program/Detail/@item.ProgramId"
                       class="btn btn-primary">
                        Detail
                    </a>

                </div>

            </div>

        </div>
    }
</div>

@if (Session["Role"] != null &&
     Session["Role"].ToString() == "Admin")
{
    <a href="/Admin"
       class="btn btn-secondary">
        Back
    </a>
}
else
{
    <a href="/Home"
       class="btn btn-secondary">
        Home
    </a>
}