@model LanguageCenter.Models.Teacher
@using LanguageCenter.Models

@{
    ViewBag.Title = "Teacher Dashboard";
    var teachingSchedule = ViewBag.TeachingSchedule as List<Class>;
    var recentActivities = ViewBag.RecentActivities as List<Registration>;
}

<div class="page-heading">
    <h2>Teacher Dashboard</h2>
    <p class="text-muted">Class totals, student totals, teaching schedule, and recent activities.</p>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card stat-card">
            <div class="card-body text-center">
                <h2>@ViewBag.TotalClasses</h2>
                <p>Total Classes</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card stat-card">
            <div class="card-body text-center">
                <h2>@ViewBag.TotalStudents</h2>
                <p>Total Students</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a href="/Teacher/MyClasses" class="btn btn-primary">My Teaching Classes</a>
    <a href="/Teacher/Materials" class="btn btn-outline-primary">Class Materials</a>
    <a href="/Teacher/PlacementResults" class="btn btn-outline-primary">Placement Results</a>
    <a href="/Teacher/Feedback" class="btn btn-outline-primary">Student Feedback</a>
    <a href="/Teacher/Profile" class="btn btn-outline-primary">Profile</a>
</div>

<section class="mt-5">
    <h3>Teaching Schedule</h3>
    <table class="table table-bordered">
        <tr>
            <th>Class</th>
            <th>Room</th>
            <th>Start Date</th>
            <th>Status</th>
        </tr>
        @foreach (var item in teachingSchedule)
        {
            <tr>
                <td>@item.ClassName</td>
                <td>@item.Room</td>
                <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Updating")</td>
                <td>@item.Status</td>
            </tr>
        }
    </table>
</section>

<section class="mt-4">
    <h3>Recent Activities</h3>
    <table class="table table-striped">
        <tr>
            <th>Student</th>
            <th>Class</th>
            <th>Registration Date</th>
            <th>Status</th>
        </tr>
        @foreach (var item in recentActivities)
        {
            <tr>
                <td>@(item.Student != null && item.Student.UserAccount != null ? item.Student.UserAccount.FullName : "Student")</td>
                <td>@(item.Class != null ? item.Class.ClassName : "Class")</td>
                <td>@(item.RegistrationDate.HasValue ? item.RegistrationDate.Value.ToString("dd/MM/yyyy") : "Updating")</td>
                <td>@item.Status</td>
            </tr>
        }
    </table>
</section>
